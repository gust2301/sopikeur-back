# ==============================================================================
# Supervision — monitor.sopikeur.sn (Beszel, /srv/monitoring)
# ==============================================================================
# Accès protégé par Cloudflare Access (code e-mail) + compte Beszel.
# Certificat interne : Access intercepte la validation Let's Encrypt, et seul
# Cloudflare (SSL Full) joint cette origine (pare-feu 80/443 limité à Cloudflare).
monitor.sopikeur.sn {
    tls internal
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Robots-Tag "noindex, nofollow"
        -Server
    }
    # Nom et icône Sopiker pour l'app iPhone (remplacent ceux de Beszel)
    @branding path /static/manifest.json /static/icon.png /static/icon-192.png /static/icon-512.png /static/icon.svg /static/brand.css /static/brand.js
    handle @branding {
        root * /srv/branding/monitoring
        uri strip_prefix /static
        header Cache-Control "no-cache"
        file_server
    }

    handle {
        # beszel-brand (nginx) remplace titre et logo puis transmet au hub
        reverse_proxy beszel-brand:8080 {
            flush_interval -1
        }
    }
}
