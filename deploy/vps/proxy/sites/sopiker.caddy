# ==============================================================================
# Sopiker — les noms DNS restent en sopikeur.sn (domaine historique)
# ==============================================================================

# Production
api.sopikeur.sn {
    import api_common

    header {
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Robots-Tag              "noindex, nofollow"
    }

    @root path /
    handle @root {
        header Content-Type "text/html; charset=utf-8"
        respond "<!doctype html><meta name='robots' content='noindex,nofollow'><title>API</title>" 200
    }

    # État de la dernière sauvegarde (écrit par /srv/sopiker/backup.sh),
    # lu par la surveillance GitHub Actions. Dates et résultat uniquement.
    handle /status/backup {
        root * /srv/status
        rewrite * /backup.json
        header Content-Type "application/json"
        header Cache-Control "no-store"
        file_server
    }

    @actuatorAllowed path /actuator/health /actuator/health/* /actuator/info
    handle @actuatorAllowed {
        reverse_proxy sopiker-backend:8080 {
            transport http {
                dial_timeout  5s
                read_timeout  30s
                write_timeout 30s
            }
        }
    }

    @actuator path /actuator*
    handle @actuator {
        respond 403
    }

    handle {
        reverse_proxy sopiker-backend:8080 {
            transport http {
                dial_timeout  5s
                read_timeout  30s
                write_timeout 30s
            }
        }
    }
}

# Staging
api-staging.sopikeur.sn {
    import api_common

    header {
        Referrer-Policy           "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Robots-Tag              "noindex, nofollow"
        X-Environment             "staging"
    }

    @actuatorAllowed path /actuator/health /actuator/health/* /actuator/info
    handle @actuatorAllowed {
        reverse_proxy sopiker-backend-staging:8080 {
            transport http {
                dial_timeout  5s
                read_timeout  60s
                write_timeout 60s
            }
        }
    }

    @actuator path /actuator*
    handle @actuator {
        respond 403
    }

    handle {
        reverse_proxy sopiker-backend-staging:8080 {
            transport http {
                dial_timeout  5s
                read_timeout  60s
                write_timeout 60s
            }
        }
    }
}
