# /etc/sudoers.d/sopiker-deploy (chmod 440, vérifier avec visudo -cf)
# L'utilisateur deploy ne peut lancer que deploy.sh (environnement + tag), /srv/erfi/deploy.sh (tag) et sopiker-status (sans argument).
deploy ALL=(root) NOPASSWD: /srv/sopiker/deploy.sh staging *, /srv/sopiker/deploy.sh production *, /srv/erfi/deploy.sh *, /srv/gust-invest/deploy.sh *, /srv/ai-agents/deploy.sh *, /usr/local/sbin/sopiker-status ""
