# Copier en /srv/sopiker/staging/.env (chmod 600). Ne jamais commiter le vrai .env.
# Lu par Docker Compose et MySQL uniquement : le backend ne le voit pas.
# Après la bascule : COMPOSE_FILE active l'accès Internet du backend.
COMPOSE_FILE=compose.yml:compose.live.yml
APP_IMAGE_TAG=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
