# ==============================================================================
# .env.staging.example — Template pour le fichier .env.staging (VPS)
# ==============================================================================
# Copier ce fichier sur le VPS : cp .env.staging.example .env.staging
# Puis remplir TOUS les champs CHANGE_ME avec des valeurs réelles.
# Ce fichier est commité dans Git (sans valeurs sensibles).
# .env.staging (avec les vraies valeurs) est gitignored.
# ==============================================================================

# ─── MySQL Staging ────────────────────────────────────────────────────────────
MYSQL_STAGING_DATABASE=sopikeur_staging
MYSQL_STAGING_USER=sopikeur_stg
MYSQL_STAGING_PASSWORD=CHANGE_ME_STRONG_PASSWORD_STG
MYSQL_STAGING_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD_STG

# ─── Backend Staging ─────────────────────────────────────────────────────────

# Tag Docker de l'image staging (branche develop → tag "develop" sur GHCR)
APP_IMAGE_TAG_STAGING=develop

# Secret JWT staging — DOIT être différent de la prod
APP_JWT_SECRET_STAGING=CHANGE_ME_LONG_RANDOM_SECRET_64_CHARS_MINIMUM

# Durée de session JWT en minutes (1440 = 24h)
APP_JWT_EXPIRATION_MINUTES=1440

# ─── Flyway placeholder ───────────────────────────────────────────────────────
# Hash bcrypt du mot de passe du super-admin créé par Flyway (même placeholder
# que dans application.yml : ${ADMIN_SUPER_PASSWORD_HASH})
ADMIN_SUPER_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH_OF_ADMIN_PASSWORD

# ─── VAPID — Push notifications ──────────────────────────────────────────────
# Générer des clés VAPID avec : npx web-push generate-vapid-keys
# Peut réutiliser les mêmes clés que prod ou générer une paire dédiée staging
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY

# ─── Cloudflare R2 (si staging utilise un bucket séparé) ─────────────────────
# Laisser vide si staging partage le bucket prod (non recommandé pour les tests)
# R2_ACCESS_KEY_ID=CHANGE_ME
# R2_SECRET_ACCESS_KEY=CHANGE_ME
# R2_BUCKET_NAME=sopikeur-staging
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ─── Antispam (limites plus permissives en staging pour faciliter les tests) ──
APP_ANTISPAM_CONTACT_REQUESTS=50
APP_ANTISPAM_CONTACT_WINDOW_SECONDS=60

# ─── JVM Staging ─────────────────────────────────────────────────────────────
JAVA_OPTS_STAGING=-Xmx384m -Xms192m
