# Copier ce fichier en .env.dev et remplir les valeurs
# .env.dev est dans .gitignore — ne jamais committer .env.dev

SPRING_PROFILES_ACTIVE=dev

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sopikeur?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=CHANGE_ME_DB_USER
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD

# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=1440

# Hash bcrypt du mot de passe super-admin de dev
ADMIN_SUPER_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# Laisser vide pour désactiver la vérification Turnstile en dev
APP_TURNSTILE_SECRET=
