{
    email contact@sopikeur.sn

# Optionnel: logs globaux
# log {
#   output stdout
#   format console
# }
}

api.sopikeur.sn {

    encode gzip

    log {
            output stdout
            format console
        }

# Headers sécurité (évite les doublons avec Spring)
    header {
               Referrer-Policy "strict-origin-when-cross-origin"
               Permissions-Policy "geolocation=(), microphone=(), camera=()"

           # HSTS: safe (sans preload tant que tout n'est pas figé)
               Strict-Transport-Security "max-age=31536000; includeSubDomains"
           }

# --- Actuator : n'autoriser que health/info ---
    @actuatorAllowed path /actuator/health /actuator/health/* /actuator/info
    handle @actuatorAllowed {
                                reverse_proxy backend:8080 {
                                                               transport http {
                                                                                  dial_timeout 5s
                                                                                  read_timeout 30s
                                                                                  write_timeout 30s
                                                                              }
                                                           }
                            }

    @actuator path /actuator*
    handle @actuator {
                         respond 403
                     }

# --- Routes normales ---
    handle {
               reverse_proxy backend:8080 {
                                              transport http {
                                                                 dial_timeout 5s
                                                                 read_timeout 30s
                                                                 write_timeout 30s
                                                             }

                                          }
           }
}