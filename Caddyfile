{
# Email pour Let's Encrypt
    email contact@sopikeur.sn

# Logs globaux (optionnel)
# debug
}

api.sopikeur.sn {

# Compression
    encode gzip

# Logs pour ce site
    log {
            output stdout
            format console
        }

# Sécurité HTTP (headers standards)
    header {
               X-Content-Type-Options "nosniff"
               X-Frame-Options "DENY"
               Referrer-Policy "strict-origin-when-cross-origin"
               Permissions-Policy "geolocation=(), microphone=(), camera=()"
           # HSTS (active seulement si tu es sûr d'être en HTTPS en prod)
               Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
           }

# --- (Optionnel) Protéger Actuator : autoriser seulement health/info ---
    @actuator path /actuator*
    @actuatorAllowed path /actuator/health /actuator/health/* /actuator/info

    handle @actuatorAllowed {
                                reverse_proxy backend:8080 {
                                                               transport http {
                                                                                  dial_timeout 5s
                                                                                  read_timeout 30s
                                                                                  write_timeout 30s
                                                                              }
                                                           }
                            }

    handle @actuator {
                         respond 403
                     }

# --- Routes normales ---
    handle {
               reverse_proxy backend:8080 {
                                              transport http {
                                                                 dial_timeout 5s
                                                                 read_timeout 30s
                                                                 write_timeout 30s
                                                             }

                                          # Forward headers (utile pour Spring)
                                              header_up X-Forwarded-Proto {scheme}
                                              header_up X-Forwarded-Host {host}
                                              header_up X-Forwarded-For {remote_host}
                                          }
           }
}
